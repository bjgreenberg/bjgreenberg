# Top-level runtime dependencies for scripts/generate_cards.py.
# The installable lockfile is requirements.txt — compiled from this file with
# hashes so CI installs are integrity-verified, not just version-pinned:
#   uv pip compile --generate-hashes --python-version 3.12 \
#     scripts/requirements.in -o scripts/requirements.txt
Pillow==12.3.0
defusedxml==0.7.1

# System dependency (NOT a pip package): ffmpeg — used to extract a hero frame
# from Mastodon video attachments. Preinstalled on GitHub's ubuntu-latest;
# locally: brew install ffmpeg. Optional — video posts fall back to the
# poster/avatar if it's missing.
